# Supabase Postgres (Project Settings > Database > Connection string > Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Optional locally; set to your production URL on Vercel if sign-in redirects misbehave
AUTH_URL=
# Google Cloud OAuth client (identity only: openid email profile)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Without a verified domain use onboarding@resend.dev (delivers only to your Resend account email)
EMAIL_FROM=AI Post Scheduler <onboarding@resend.dev>

# Protects /api/cron/dispatch (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
